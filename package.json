{
  "name": "t3code-mcp",
  "version": "0.3.0",
  "description": "Standalone account-wide MCP bridge for T3 Code",
  "license": "MIT",
  "author": "emmsixx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmsixx/t3code-mcp.git"
  },
  "homepage": "https://github.com/emmsixx/t3code-mcp#readme",
  "bugs": {
    "url": "https://github.com/emmsixx/t3code-mcp/issues"
  },
  "keywords": [
    "mcp",
    "t3-code",
    "t3-connect",
    "coding-agent",
    "hermes"
  ],
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "bin": {
    "t3code-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/agent-setup.md",
    "docs/configuration.md",
    "docs/tools.md",
    "docs/authentication.md",
    "docs/verification.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && tsx --test test/*.test.ts",
    "test:package": "node scripts/check-package.mjs",
    "test:upgrade": "tsx scripts/check-upgrade.ts",
    "check:public": "node scripts/check-public.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "prepack": "pnpm run build",
    "start": "node dist/cli.js serve",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
